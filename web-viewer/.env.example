# Kinesia web app configuration (copy to .env.local to override).
#
# The app serves the UI and its API from one process on 127.0.0.1; none of
# these variables are needed for the usual local setup.

# Checkout root (defaults to the folder above web-viewer/).
# KINESIA_ROOT=/path/to/kinesia

# Where analyses are stored (default: output/ in the checkout).
# KINESIA_RUNS_ROOT=output

# Extra browser origins allowed to call the API, comma-separated. Only needed
# when the page is served from another host than the API.
# KINESIA_ALLOWED_ORIGINS=https://kinesia.example.org
