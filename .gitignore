# Python
__pycache__/
*.py[oc]
build/
dist/
*.egg-info/
.venv/

# Web app
web-viewer/node_modules*
web-viewer/.next*
web-viewer/tsconfig.tsbuildinfo

# Videos, analyses and model weights stay local
input/*
!input/.gitkeep
output/*
!output/.gitkeep
models/*
!models/.gitkeep
benchmarks/

# Upstream demo media (the code under vendor/ is kept so the cluster job runs)
vendor/sam-3d-body-main/assets/
vendor/sam-3d-body-main/notebook/
# Optional external runtime, not part of Kinesia
vendor/sam3d-objects-mlx/

# Personal cluster settings (the job scheduler project, UID, volume paths)
/cluster/config.env

# Local notes and scratch files, never published
/PROJECT.md
/CHANGELOG.md
/report/
/scripts_*
docs/*.pdf
docs/*.pptx
_cap*.mjs

# Local settings and secrets
.env
.env.*
!.env.example

# macOS and iCloud copies ("viewer 2.tsx")
.DS_Store
* 2
* 2.*
