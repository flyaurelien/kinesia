# Optional local settings: copy to local.env (git-ignored) and uncomment what
# you need. Paths are relative to the project root; the environment wins.

# Where the model files are (defaults shown; scripts/install_models.py puts them there).
# SAM31_CHECKPOINT=models/sam3.1/sam3.1_multiplex.pt
# SAM3D_BODY_DIR=models/sam-3d-body-dinov3
# MOGE_WEIGHTS=models/moge-2-vitl-normal/model.pt
# DINOV3_WEIGHTS=models/dinov3-vith16plus/model.safetensors

# A facebookresearch/sam3 checkout, if the sam3 package is not installed.
# SAM3_SOURCE=

# Advanced: run the GPU stages somewhere else with your own runner, a subclass
# of kinesia.pipeline.Runner, given as module:Class, importable from the
# folders listed in KINESIA_PLUGIN_PATH.
# KINESIA_RUNNER=
# KINESIA_PLUGIN_PATH=
